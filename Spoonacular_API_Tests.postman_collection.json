                  "value": "{{SPOONACULAR_API_KEY}}"
                },
                {
                  "key": "addRecipeInformation",
                  "value": "true"
                }
              ]
            },
            "description": "Get detailed information about a specific recipe (replace {{RECIPE_ID}} with actual recipe ID, e.g., 715495)"
