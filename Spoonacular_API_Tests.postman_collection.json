        {
          "name": "Complex Search - All Recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.spoonacular.com/recipes/complexSearch?apiKey={{SPOONACULAR_API_KEY}}&number=10&addRecipeInformation=true&addRecipeNutrition=true",
              "protocol": "https",
              "host": [
                "api",
                "spoonacular",
                "com"
              ],
              "path": [
                "recipes",
                "complexSearch"
              ],
              "query": [
                {
                  "key": "apiKey",
                  "value": "{{SPOONACULAR_API_KEY}}"
                },
                {
                  "key": "number",
                  "value": "10"
                },
                {
                  "key": "addRecipeInformation",
                  "value": "true"
                },
                {
                  "key": "addRecipeNutrition",
                  "value": "true"
                }
              ]
            },
            "description": "Get 10 random recipes with full information and nutrition data"
          },
          "response": []
        },
