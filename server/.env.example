# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mindfulmeals?retryWrites=true&w=majority

# API Keys
USDA_API_KEY=your-usda-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Email Configuration (Brevo)
EMAIL_USER=your-email
EMAIL_PASS=your-app-password

# Dialogflow Configuration
DIALOGFLOW_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./path-to-credentials.json

# FatSecret Configuration
FATSECRET_CLIENT_ID=your-client-id
FATSECRET_CLIENT_SECRET=your-client-secret

# App Configuration
APP_URL=http://localhost:3000

